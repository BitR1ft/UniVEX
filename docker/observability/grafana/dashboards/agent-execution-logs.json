{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "UniVex agent execution logs — agent role, flow_id, trace_id correlation, error rates",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "All agent log entries filterable by role, level, and flow_id",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service=\"backend\", agent_role=~\"$agent_role\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Agent Execution Logs",
      "type": "logs"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Count of log entries per minute by agent role",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "right"}},
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (agent_role) (count_over_time({service=\"backend\", agent_role=~\"$agent_role\"}[$__interval]))",
          "legendFormat": "{{agent_role}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Agent Role",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Error and warning log entries across all agents",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "WARNING"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 3,
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (level) (count_over_time({service=\"backend\", level=~\"ERROR|WARNING\"}[$__interval]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors & Warnings Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Recent error logs with trace_id for Jaeger correlation",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service=\"backend\", level=\"ERROR\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent Agent Errors (with Trace Correlation)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["univex", "agents", "logs"],
  "templating": {
    "list": [
      {
        "current": {"text": ".*", "value": ".*"},
        "datasource": {"type": "loki", "uid": "loki"},
        "definition": "label_values({service=\"backend\"},agent_role)",
        "hide": 0,
        "includeAll": true,
        "label": "Agent Role",
        "multi": true,
        "name": "agent_role",
        "options": [],
        "query": "label_values({service=\"backend\"},agent_role)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {"text": "", "value": ""},
        "hide": 0,
        "label": "Search",
        "name": "search",
        "options": [{"selected": true, "text": "", "value": ""}],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "UniVex — Agent Execution Logs",
  "uid": "univex-agent-logs",
  "version": 1
}
