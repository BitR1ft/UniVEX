{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"},
    {"type": "datasource", "id": "jaeger", "name": "Jaeger", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "UniVex API error monitoring — 4xx/5xx rates, MCP tool failures, trace correlation via trace_id",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "API error logs (4xx/5xx responses and exceptions)",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service=\"backend\", level=\"ERROR\"} | json | line_format \"{{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API Error Logs (with trace_id → Jaeger link)",
      "type": "logs"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Error rate per minute across all API endpoints",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "red", "mode": "fixed"},
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 2,
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({service=\"backend\", level=\"ERROR\"}[$__interval]))",
          "legendFormat": "Errors/min",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "API Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "MCP tool call failures (naabu, nuclei, metasploit, etc.)",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 3,
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (logger) (count_over_time({service=\"backend\", level=\"ERROR\", logger=~\"app.agent.tools.*\"}[$__interval]))",
          "legendFormat": "{{logger}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "MCP Tool Failure Rate by Tool",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "description": "Log volume over time split by log level",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ERROR"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "WARNING"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "INFO"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 18},
      "id": 4,
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum by (level) (count_over_time({service=\"backend\"}[$__interval]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Volume by Level",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "jaeger", "uid": "jaeger"},
      "description": "Recent traces from UniVex agents — click a trace to see full span tree",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 26},
      "id": 5,
      "options": {
        "search": {
          "service": "univex-api",
          "tags": ""
        }
      },
      "targets": [
        {
          "datasource": {"type": "jaeger", "uid": "jaeger"},
          "queryType": "search",
          "refId": "A",
          "service": "univex-api"
        }
      ],
      "title": "Recent Traces (Jaeger)",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["univex", "api", "errors", "traces"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "UniVex — API Errors & Trace Correlation",
  "uid": "univex-api-errors-traces",
  "version": 1
}
