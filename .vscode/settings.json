{
  // ============================================================================
  // UniVex — VSCode Workspace Settings
  // ============================================================================

  // ---------------------------------------------------------------------------
  // Python (Backend)
  // ---------------------------------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.envFile": "${workspaceFolder}/backend/.env",

  // Pytest as the default test runner
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "backend/tests",
    "--ignore=backend/tests/test_auth.py",
    "-q"
  ],
  "python.testing.cwd": "${workspaceFolder}",

  // Black formatter
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "black-formatter.args": ["--line-length", "100"],
  "isort.args": ["--profile", "black", "--line-length", "100"],

  // Ruff linter
  "ruff.enable": true,
  "ruff.lint.args": ["--line-length=100"],
  "ruff.organizeImports": false,

  // Mypy type checking
  "mypy-type-checker.args": [
    "--ignore-missing-imports",
    "--disallow-untyped-defs"
  ],

  // ---------------------------------------------------------------------------
  // TypeScript / Next.js (Frontend)
  // ---------------------------------------------------------------------------
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // Use the project's tsconfig for IntelliSense
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ESLint
  "eslint.workingDirectories": ["./frontend"],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Prettier
  "prettier.configPath": "frontend/.prettierrc",

  // ---------------------------------------------------------------------------
  // Editor
  // ---------------------------------------------------------------------------
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,

  // ---------------------------------------------------------------------------
  // Files
  // ---------------------------------------------------------------------------
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/*.egg-info": true,
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.venv/**": true
  },
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "docker-compose*.yml": "dockercompose",
    ".env*": "dotenv"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ---------------------------------------------------------------------------
  // YAML / JSON
  // ---------------------------------------------------------------------------
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml",
    "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": "docker-compose*.yml"
  },

  // ---------------------------------------------------------------------------
  // Terminal
  // ---------------------------------------------------------------------------
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/backend"
  },

  // ---------------------------------------------------------------------------
  // Git
  // ---------------------------------------------------------------------------
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ---------------------------------------------------------------------------
  // Docker
  // ---------------------------------------------------------------------------
  "docker.defaultRegistryPath": "ghcr.io/bitr1ft",

  // ---------------------------------------------------------------------------
  // REST Client
  // ---------------------------------------------------------------------------
  "rest-client.environmentVariables": {
    "local": {
      "baseUrl": "http://localhost:8000",
      "frontendUrl": "http://localhost:3000"
    },
    "staging": {
      "baseUrl": "https://staging.univex.io",
      "frontendUrl": "https://staging.univex.io"
    }
  },

  // ---------------------------------------------------------------------------
  // Todo Tree
  // ---------------------------------------------------------------------------
  "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "SECURITY", "PERF", "NOTE"],
  "todo-tree.highlights.customHighlight": {
    "SECURITY": {
      "icon": "shield",
      "foreground": "#ff0000",
      "background": "#ff000020",
      "iconColour": "#ff0000"
    },
    "PERF": {
      "icon": "zap",
      "foreground": "#ffaa00",
      "iconColour": "#ffaa00"
    }
  },

  // ---------------------------------------------------------------------------
  // Spell Check
  // ---------------------------------------------------------------------------
  "cSpell.words": [
    "univex", "bitr1ft", "pentagi", "langgraph", "asyncpg", "pydantic",
    "langchain", "nuclei", "naabu", "ffuf", "wpscan", "sqlmap", "metasploit",
    "kimi", "vllm", "qwen", "deepseek", "bedrock", "groq", "searxng",
    "graphiti", "chromadb", "pgvector", "prisma", "fastapi", "uvicorn",
    "autochain", "ctester", "ftester", "etester", "cvss", "owasp",
    "capec", "mitre", "idor", "ssrf", "csrf", "lfi", "rfi", "xxe",
    "totp", "rbac", "socks5", "ollama", "jinja2", "recharts"
  ]
}
