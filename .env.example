# Environment Variables Configuration

# ==============================================================================
# GENERAL CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PYTHON_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=univex
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=univex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_secure_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ==============================================================================
# BACKEND API CONFIGURATION
# ==============================================================================

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Security
# REQUIRED: SECRET_KEY must be set before starting the application.
# The server will REFUSE TO START if this is missing or is a known placeholder.
# Generate a secure value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Example output: a1b2c3d4e5f6...  (64-char hex string)
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==============================================================================
# AI & LLM CONFIGURATION
# ==============================================================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Optional — free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Groq (Optional — free tier available, fast inference)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (Optional — access 100+ models via one API)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# LangSmith (Optional - for debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=univex

# ==============================================================================
# AUTOCHAIN — AUTOMATED PENTEST PIPELINE (Week 1 Betterment Plan)
# ==============================================================================

# Maximum risk level auto-approved without human confirmation.
# Values: none | low | medium | high | critical
# Recommended settings:
#   none     — all exploits require manual approval (default, safest)
#   high     — auto-approve low/medium/high exploits; critical still needs approval
#   critical — fully autonomous mode for HTB labs / isolated lab environments
AUTO_APPROVE_RISK_LEVEL=none

# MCP server URLs (defaults work with the standard Docker Compose setup)
NAABU_MCP_URL=http://kali-tools:8000
NUCLEI_MCP_URL=http://kali-tools:8002
MSF_MCP_URL=http://kali-tools:8003

# ==============================================================================
# TOOL CONFIGURATION
# ==============================================================================

# Nmap Configuration
NMAP_RATE_LIMIT=1000
NMAP_TIMING_TEMPLATE=4

# Nuclei Configuration
NUCLEI_RATE_LIMIT=150
NUCLEI_BULK_SIZE=25
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates

# Metasploit Configuration
METASPLOIT_HOST=metasploit
METASPLOIT_PORT=55553
METASPLOIT_USER=msf
METASPLOIT_PASSWORD=change_this_secure_password

# ==============================================================================
# DOCKER & INFRASTRUCTURE
# ==============================================================================

# Container Configuration
DOCKER_NETWORK=univex-network
KALI_TOOLS_IMAGE=kalilinux/kali-rolling:latest

# Volume Paths
POSTGRES_DATA_PATH=./postgres-data
NEO4J_DATA_PATH=./neo4j-data
LOGS_PATH=./logs

# ==============================================================================
# LOGGING & MONITORING
# ==============================================================================

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/univex/app.log

# ==============================================================================
# SECURITY & RATE LIMITING
# ==============================================================================

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Session Settings
SESSION_TIMEOUT_MINUTES=120

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable/Disable Features
FEATURE_AI_AGENT=true
FEATURE_AUTO_EXPLOITATION=false
FEATURE_REPORT_GENERATION=true
FEATURE_GRAPH_VISUALIZATION=true

# ==============================================================================
# THIRD-PARTY SERVICES
# ==============================================================================

# Vulnerability Databases
NVD_API_KEY=your_nvd_api_key_here
VULNERS_API_KEY=your_vulners_api_key_here

# Interactsh (for OAST)
INTERACTSH_SERVER=oast.pro
INTERACTSH_TOKEN=your_interactsh_token_here

# ==============================================================================
# OSINT & INTERNET-WIDE SEARCH (Day 4)
# ==============================================================================

# Shodan — https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# Censys — https://search.censys.io/account/api
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# FOFA — https://fofa.info/userInfo
FOFA_API_EMAIL=your_fofa_email_here
FOFA_API_KEY=your_fofa_api_key_here

# SecurityTrails (Passive DNS) — https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# VirusTotal (Passive DNS) — https://www.virustotal.com/gui/user/apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ==============================================================================
# TESTING CONFIGURATION
# ==============================================================================

# Test Database
TEST_DATABASE_URL=postgresql://test:test@localhost:5433/univex_test

# HTB Configuration (for validation)
HTB_API_KEY=your_htb_api_key_here
HTB_VPN_CONFIG=/path/to/htb.ovpn

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# Hot Reload
WATCH_FILES=true

# ==============================================================================
# OBSERVABILITY
# ==============================================================================

# Grafana (REQUIRED — must be set before running docker-compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_to_a_strong_password_min_16_chars

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Rotate all secrets regularly
# 4. Use strong passwords (minimum 16 characters)
# 5. Enable 2FA where available
# 6. Review security settings before production deployment

# ==============================================================================
# v1.1.0 — NEW SETTINGS
# ==============================================================================

# Redis (required for distributed rate-limiting, job queue, and caching)
REDIS_URL=redis://redis:6379/0

# Two-Factor Authentication (TOTP)
TOTP_ISSUER=UniVex

# Account Lockout (brute-force protection)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=300
LOCKOUT_DURATION_SECONDS=900

# IP Allowlist for admin endpoints (comma-separated CIDRs; leave empty to allow all)
# Example: ADMIN_IP_ALLOWLIST=10.0.0.0/8,192.168.1.0/24
ADMIN_IP_ALLOWLIST=

# Cloud Security Scanning (optional — only needed for cloud tool usage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=


# ==============================================================================
# Day 6 — Proxy Engine (MITM Intercepting Proxy)
# ==============================================================================

# Port the intercepting proxy listens on (configure browser to use this as proxy)
# Note: must not conflict with SearXNG (8080) or the OOB listener (8090)
PROXY_PORT=8888

# Optional upstream proxy — leave empty for direct connections
# Example: PROXY_UPSTREAM=http://corporate-proxy.internal:3128
PROXY_UPSTREAM=

# Verify upstream SSL certificate (set to true in high-trust environments)
PROXY_SSL_VERIFY=false

# Bearer token for the Proxy MCP server API (leave empty to disable auth)
PROXY_MCP_API_KEY=

# Port for the Proxy MCP control server (agent-facing JSON-RPC API)
PROXY_MCP_PORT=8008

# ==============================================================================
# Day 15 — OOB Listener (Out-of-Band Callback Server)
# ==============================================================================

# External IP that targets will call back to (set to your public IP in real engagements)
OOB_EXTERNAL_IP=127.0.0.1

# Host port for HTTP callbacks — mapped to container port 8080 internally
# Note: must not conflict with SearXNG (8080) or the proxy (8888)
OOB_HTTP_PORT=8090

# Host port for SMTP callbacks
OOB_SMTP_PORT=2525

# Host port for DNS callbacks (UDP)
OOB_DNS_PORT=5353

# Token TTL in seconds (how long a generated OOB token remains valid)
OOB_TOKEN_TTL=3600
